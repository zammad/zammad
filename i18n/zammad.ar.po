#. This is the template file app/views/mailer/password_reset/en.html.erb in ERB/HTML format.
#. Please make sure to translate it to a valid corresponding output structure.
#: app/views/mailer/password_reset/en.html.erb
msgid ""
"Reset your #{config.product_name} password\n"
"\n"
"<div>Hi #{user.firstname},</div>\n"
"<br>\n"
"<div>We received a request to reset the password for your "
"#{config.product_name} account <b>#{user.login}</b>.</div>\n"
"<br>\n"
"<div>If you want to reset your password, click on the link below (or copy "
"and paste the URL into your browser):</div>\n"
"<br>\n"
"<div><a href=\"#{url}\">#{url}</a></div>\n"
"<br>\n"
"<div>This link takes you to a page where you can change your password.</"
"div>\n"
"<br>\n"
"<div>If you don't want to reset your password, please ignore this message. "
"Your password will not be reset.</div>\n"
"<br>\n"
"<div>Your #{config.product_name} Team</div>\n"
msgstr ""
"إعادة تعيين كلمة المرور في #{config.product_name}\n"
"\n"
"<div>مرحبًا #{user.firstname}،</div>\n"
"<br>\n"
"<div>تلقينا طلبًا لإعادة تعيين كلمة المرور لحسابكم في #{config.product_name} "
"<b>#{user.login}</b>.</div>\n"
"<br>\n"
"<div>إذا كنتم ترغبون في إعادة تعيين كلمة المرور، يرجى النقر على الرابط أدناه "
"(أو نسخ العنوان ولصقه في المتصفح):</div>\n"
"<br>\n"
"<div><a href=\"#{url}\">#{url}</a></div>\n"
"<br>\n"
"<div>ينقلكم هذا الرابط إلى صفحة تغيير كلمة المرور.</div>\n"
"<br>\n"
"<div>إذا كنتم لا ترغبون في إعادة تعيين كلمة المرور، يرجى تجاهل هذه الرسالة، "
"ولن تتم إعادة تعيين كلمة المرور.</div>\n"
"<br>\n"
"<div>فريق #{config.product_name}</div>\n"

