"<div>The new ticket (#{ticket.title}) has been created by "
"\"<b>#{current_user.longname}</b>\".</div>\n"
"<br>\n"
"<div>\n"
"Group: #{ticket.group.name}<br>\n"
"Owner: #{ticket.owner.fullname}<br>\n"
"State: #{t(ticket.state.name)}<br>\n"
"</div>\n"
"<br>\n"
"<% if @objects[:article] %>\n"
"  <div>\n"
"  Information:\n"
"  <blockquote type=\"cite\">\n"
"  #{article.body_as_html}\n"
"  </blockquote>\n"
"  </div>\n"
"<% end %>\n"
"<br>\n"
"<div>\n"
"  <a href=\"#{config.http_type}://#{config.fqdn}/#ticket/zoom/#{ticket.id}\" "
"target=\"zammad_app\">View this in #{config.product_name}</a>\n"
"</div>\n"
msgstr ""
"تذكرة جديدة (#{ticket.title})\n"
"\n"
"<div>مرحبًا #{recipient.firstname}،</div>\n"
"<br>\n"
"<div>تم إنشاء تذكرة جديدة (#{ticket.title}) بواسطة "
"\"<b>#{current_user.longname}</b>\".</div>\n"
"<br>\n"
"<div>\n"
"المجموعة: #{ticket.group.name}<br>\n"
"المالك: #{ticket.owner.fullname}<br>\n"
"الحالة: #{t(ticket.state.name)}<br>\n"
"</div>\n"
"<br>\n"
"<% if @objects[:article] %>\n"
"  <div>\n"
"  المعلومات:\n"
"  <blockquote type=\"cite\">\n"
"  #{article.body_as_html}\n"
"  </blockquote>\n"
"  </div>\n"
"<% end %>\n"
"<br>\n"
"<div>\n"
"  <a href=\"#{config.http_type}://#{config.fqdn}/#ticket/zoom/#{ticket.id}\" "
"target=\"zammad_app\">عرض في #{config.product_name}</a>\n"
"</div>\n"

