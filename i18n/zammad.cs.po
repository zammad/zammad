#: app/assets/javascripts/app/models/ticket_priority.coffee:8
msgid ""
"Defines an optional icon of this priority in ticket tables. Important will "
"be rendered with an exclamation point, while low priority with a downwards "
"arrow."
msgstr ""
"Definuje volitelnou ikonu této priority v tabulkách tiketů. Důležitá "
"priorita se zobrazí s vykřičníkem, nízká priorita se šipkou dolů."

#: db/seeds/settings.rb:3788
msgid "Defines attachment extensions which will be ignored by Elasticsearch."
msgstr "Definuje přípony příloh, které bude Elasticsearch ignorovat."

#: db/seeds/settings.rb:3743
msgid "Defines endpoint of Elasticsearch."
msgstr "Definuje koncový bod pro Elasticsearch."

#: app/assets/javascripts/app/views/ai/ticket_summary.jst.eco:54
msgid ""
"Defines global configuration when the summary will be generated in the "
"ticket zoom."
msgstr ""
"Určuje globální nastavení, kdy se při zobrazení tiketu vygeneruje shrnutí."

#: db/seeds/settings.rb:3047
msgid ""
"Defines groups for which a customer can create tickets via web interface. No "
"selection means all groups are available."
msgstr ""
"Definuje skupiny, ve kterých může zákazník vytvářet tikety přes webové "
"rozhraní. Pokud nic nevyberete, budou dostupné všechny skupiny."

#: db/seeds/settings.rb:3344
msgid ""
"Defines how the From field of emails (sent from answers and email tickets) "
"should look like."
msgstr ""
"Definuje, jak má vypadat pole From (Od) v e-mailech (zaslaných z odpovědí a "
"e-mailových tiketů)."

#: db/seeds/settings.rb:2416
msgid ""
"Defines how the last customer contact time of tickets should be calculated."
msgstr "Definuje, jakým způsobem se počítá čas posledního kontaktu zákazníka."

#: db/seeds/settings.rb:354
msgid ""
"Defines how to reach WebSocket server. \"websocket\" is default on "
"production, \"websocketPort\" is for CI."
msgstr ""
"Určuje, jak se připojit k WebSocket serveru. \"websocket\" je výchozí v "
"produkci, \"websocketPort\" je pro CI."

#: db/seeds/settings.rb:260
msgid ""
"Defines how user names are displayed in dropdowns, overviews and selection "
"fields."
msgstr ""
"Určuje, jak se zobrazují jména uživatelů v rozbalovacích seznamech, "
"přehledech a výběrových polích."

#: db/seeds/settings.rb:4795
msgid "Defines if Checkmk (https://checkmk.com/) is enabled or not."
msgstr "Definuje, zda je Checkmk (https://checkmk.com/) povoleno nebo nikoli."

#: db/seeds/settings.rb:5481
msgid "Defines if Clearbit (http://www.clearbit.com) is enabled or not."
msgstr ""
"Definuje, zda je Clearbit (http://www.clearbit.com) povolen nebo nikoli."

#: db/seeds/settings.rb:5082
msgid "Defines if Exchange is enabled or not."
msgstr "Definuje, zda je Exchange povolen nebo nikoli."

#: db/seeds/settings.rb:4599
msgid "Defines if Icinga (http://www.icinga.org) is enabled or not."
msgstr "Definuje, zda je Icinga (http://www.icinga.org) povolena nebo nikoli."

#: db/seeds/settings.rb:5692
msgid ""
"Defines if Knowledge Base navbar button is enabled for users without "
"Knowledge Base permission."
msgstr ""
"Určuje, zda je navigační tlačítko znalostní báze zapnuté pro uživatele bez "
"oprávnění ke znalostní bázi."

#: db/seeds/settings.rb:5677
msgid "Defines if Knowledge Base navbar button is enabled."
msgstr "Určuje, zda je navigační tlačítko znalostní báze zapnuté."

#: db/seeds/settings.rb:5029
msgid "Defines if LDAP is enabled or not."
msgstr "Definuje, zda je LDAP povoleno nebo nikoli."

#: db/seeds/settings.rb:4928
msgid "Defines if Monit (https://mmonit.com/monit/) is enabled or not."
msgstr ""
"Definuje, zda je Monit (https://mmonit.com/monit/) povolen nebo nikoli."

#: db/seeds/settings.rb:4697
msgid "Defines if Nagios (http://www.nagios.org) is enabled or not."
msgstr "Definuje, zda je Nagios (http://www.nagios.org) povolen nebo nikoli."

#: db/seeds/settings.rb:5875
msgid "Defines if PGP encryption is enabled or not."
msgstr "Určuje, zda je PGP šifrování povoleno, či nikoli."

#: db/seeds/settings.rb:5418
msgid "Defines if Placetel (http://www.placetel.de) is enabled or not."
msgstr ""
"Definuje, zda je Placetel (http://www.placetel.de) povolen nebo nikoli."

#: db/seeds/settings.rb:5805
msgid "Defines if S/MIME encryption is enabled or not."
msgstr "Definuje, zda je S/MIME šifrování povoleno nebo nikoli."

#: db/seeds/settings.rb:3020
msgid "Defines if a customer can create tickets via the web interface."
msgstr "Definuje, zda zákazník může vytvářet tikety přes webové rozhraní."

#: db/seeds/settings.rb:5956
msgid "Defines if a translation service is configured."
msgstr "Určuje, zda je nakonfigurována překladová služba."

#: db/seeds/settings.rb:20
msgid "Defines if application is in init mode."
msgstr "Definuje, zda je aplikace v inicializačním režimu."

#: db/seeds/settings.rb:87
msgid "Defines if application is used as online service."
msgstr "Definuje, zda je aplikace používána jako online služba."

#: db/seeds/settings.rb:6082
msgid ""
"Defines if calendar weeks are shown in the picker of date/datetime fields to "
"easily select the correct date."
msgstr ""
"Určuje, zda se ve výběru data u polí s datem a časem zobrazují kalendářní "
"týdny, aby bylo snazší vybrat správné datum."

#: db/seeds/settings.rb:5343
msgid "Defines if generic CTI integration is enabled or not."
msgstr "Definuje, zda je obecná CTI integrace povolena nebo nikoli."

#: db/seeds/settings.rb:6174
msgid ""
"Defines if recovery codes can be used by users in the event they lose access "
"to other two-factor authentication methods."
msgstr ""
"Určuje, zda mohou uživatelé použít obnovovací kódy v případě, že ztratí "
"přístup k jiným metodám dvoufaktorového ověřování."

#: db/seeds/settings.rb:5260
msgid "Defines if sipgate.io (http://www.sipgate.io) is enabled or not."
msgstr ""
"Definuje, zda je sipgate.io (http://www.sipgate.io) povolen nebo nikoli."

#: db/seeds/settings.rb:5917
msgid "Defines if system notification emails are PGP signed."
msgstr "Určuje, zda jsou systémové e-maily s oznámeními podepsány pomocí PGP."

#: db/seeds/settings.rb:5847
msgid "Defines if system notification emails are S/MIME signed."
msgstr ""
"Určuje, zda jsou systémové e-maily s oznámeními podepsány pomocí S/MIME."

#: db/seeds/settings.rb:6459
msgid "Defines if the AI provider is configured."
msgstr "Určuje, zda je nakonfigurován poskytovatel AI."

#: db/seeds/settings.rb:5191
msgid ""
"Defines if the GitHub (http://www.github.com) integration is enabled or not."
msgstr ""
"Definuje, zda je integrace GitHub (http://www.github.com) povolena nebo "
"nikoli."

#: db/seeds/settings.rb:5149
msgid ""
"Defines if the GitLab (http://www.gitlab.com) integration is enabled or not."
msgstr ""
"Definuje, zda je integrace GitLab (http://www.gitlab.com) povolena nebo "
"nikoli."

#: db/seeds/settings.rb:5945
msgid "Defines if the PGP recipient alias configuration is enabled or not."
msgstr "Určuje, zda je konfigurace aliasu příjemce PGP povolena nebo ne."

#: db/seeds/settings.rb:727
msgid ""
"Defines if the agent has to accept a confirmation dialog when changing the "
"article visibility to \"public\"."
msgstr ""
"Určuje, zda musí agent při změně viditelnosti článku na \"veřejný\" potvrdit "
"dialog."

#: db/seeds/settings.rb:77
msgid ""
"Defines if the application is in developer mode (all users have the same "
"password and password reset will work without email delivery)."
msgstr ""
"Definuje, zda je aplikace v režimu vývojáře (všichni uživatelé mají stejné "
"heslo a obnovení hesla funguje bez doručení e-mailu)."

#: db/seeds/settings.rb:6680
msgid ""
"Defines if the bubble menu feature of the richtext editor is enabled. Note "
"that this setting will be ignored if the writing assistant is turned on."
msgstr ""
"Určuje, zda je v editoru formátovaného textu zapnuta plovoucí nabídka. Pokud "
"je zapnutý asistent psaní, toto nastavení se ignoruje."

#: db/seeds/settings.rb:6226
msgid ""
"Defines if the change of the primary organization of a user will update the "
"100 most recent tickets for this user as well."
msgstr ""
"Definuje, zda změna primární organizace uživatele aktualizuje také 100 "
"posledních tiketů tohoto uživatele."

#: db/seeds/settings.rb:646
msgid ""
"Defines if the core workflow communication should run over AJAX instead of "
"WebSocket."
msgstr ""
"Určuje, zda má komunikace Core Workflow probíhat přes AJAX místo WebSocketu."

#: db/seeds/settings.rb:672
msgid ""
"Defines if the email should be displayed in the result of the user/"
"organization widget."
msgstr ""
"Definuje, zda se ve výsledcích widgetu uživatelů/organizací zobrazuje e-mail."

#: db/seeds/settings.rb:5109
msgid ""
"Defines if the i-doit (https://www.i-doit.org/) integration is enabled or "
"not."
msgstr ""
"Definuje, zda je integrace i-doit (https://www.i-doit.org/) povolena nebo "
"nikoli."

#: db/seeds/settings.rb:2443
msgid ""
"Defines if the ticket conditions editor supports complex logical expressions."
msgstr ""
"Definuje, zda editor podmínek tiketu podporuje komplexní logické výrazy."

#: db/seeds/settings.rb:2469
msgid ""
"Defines if the ticket conditions editor supports regular expression "
"operators for triggers and ticket auto assignment."
msgstr ""
"Určuje, zda editor podmínek tiketů podporuje operátory regulárních výrazů "
"pro spouštěče a automatické přiřazování tiketů."

#: db/seeds/settings.rb:4249
msgid "Defines if the time accounting types are enabled."
msgstr "Určuje, zda jsou zapnuté typy počítání času."

#: db/seeds/settings.rb:6142
msgid ""
"Defines if the two-factor authentication method authenticator app is enabled "
"or not."
msgstr ""
"Určuje, zda je zapnutá metoda dvoufaktorového ověřování pomocí autentizační "
"aplikace."

#: db/seeds/settings.rb:6110
msgid ""
"Defines if the two-factor authentication method security keys is enabled or "
"not."
msgstr ""
"Určuje, zda je zapnutá metoda dvoufaktorového ověřování pomocí "
"bezpečnostních klíčů."

#: db/seeds/settings.rb:3101
msgid "Defines if tickets can be created via web form."
msgstr "Definuje, zda je možné vytvářet tikety pomocí webového formuláře."

#: db/seeds/settings.rb:4648
msgid "Defines if tickets should be closed if service is recovered."
msgstr "Definuje, zda se mají tikety uzavřít, když se služba obnoví."

#: db/seeds/settings.rb:4500
msgid "Defines postmaster filter for filters managed via admin interface."
msgstr "Definuje filtr správce pošty pro filtry spravované v administraci."

#: db/seeds/settings.rb:4401
msgid ""
"Defines postmaster filter to check if email has been created by Zammad "
"itself and will set the article sender."
msgstr ""
"Definuje filtr správce pošty, který kontroluje, zda e-mail vytvořil sám "
"Zammad, a nastaví odesílatele článku."

#: db/seeds/settings.rb:4410
msgid ""
"Defines postmaster filter to check if the email is a self-created "
"notification email, then ignore it to prevent email loops."
msgstr ""
"Definuje filtr správce pošty, který kontroluje, zda jde o e-mail s oznámením "
"vytvořený samotným systémem, a v tom případě jej ignoruje, aby nevznikaly e-"
"mailové smyčky."

#: db/seeds/settings.rb:4437
msgid "Defines postmaster filter to handle secure mailing."
msgstr "Definuje filtr správce pošty pro zpracování zabezpečené pošty."

#: db/seeds/settings.rb:4563
msgid ""
"Defines postmaster filter to identify Jira mails for correct follow-ups."
msgstr ""
"Definuje filtr správce pošty pro identifikaci e-mailů z Jiry kvůli správnému "
"přiřazení navazujících zpráv."

#: db/seeds/settings.rb:4545
msgid ""
"Defines postmaster filter to identify ServiceNow mails for correct follow-"
"ups."
msgstr ""
"Definuje filtr správce pošty pro identifikaci e-mailů ze ServiceNow kvůli "
"správnému přiřazení navazujících zpráv."

#: db/seeds/settings.rb:4347
msgid ""
"Defines postmaster filter to identify auto responses to prevent auto replies "
"from Zammad."
msgstr ""
"Definuje filtr správce pošty pro identifikaci automatických odpovědí, aby na "
"ně Zammad neodesílal automatické odpovědi."

#: db/seeds/settings.rb:4365
msgid ""
"Defines postmaster filter to identify follow-up ticket for merged tickets."
msgstr ""
"Definuje filtr správce pošty pro identifikaci tiketu pro navazující zprávy u "
"sloučených tiketů."

#: db/seeds/settings.rb:4356
msgid ""
"Defines postmaster filter to identify follow-ups (based on admin settings)."
msgstr ""
"Definuje filtr správce pošty pro identifikaci navazujících zpráv (podle "
"nastavení administrátora)."

#: db/seeds/settings.rb:4455
msgid ""
"Defines postmaster filter to identify out-of-office emails for follow-up "
"detection and keeping current ticket state."
msgstr ""
"Definuje filtr správce pošty pro identifikaci e-mailů s automatickou "
"odpovědí o nepřítomnosti kvůli rozpoznání navazujících zpráv a zachování "
"aktuálního stavu tiketu."

#: db/seeds/settings.rb:4482
msgid ""
"Defines postmaster filter to identify postmaster bounces; and disables "
"sending notification if delivery fails permanently."
msgstr ""
"Definuje filtr správce pošty pro identifikaci vrácených e-mailů, který vypne "
"zasílání oznámení, pokud doručení trvale selže."

#: db/seeds/settings.rb:4473
msgid ""
"Defines postmaster filter to identify postmaster bounces; and handles them "
"as follow-up of the original tickets."
msgstr ""
"Definuje filtr správce pošty pro identifikaci vrácených e-mailů, který je "
"zpracuje jako navazující zprávy k původním tiketům."

#: db/seeds/settings.rb:4491
msgid ""
"Defines postmaster filter to identify postmaster bounces; and reopens "
"tickets if delivery fails permanently."
msgstr ""
"Definuje filtr správce pošty pro identifikaci vrácených e-mailů, který znovu "
"otevře tikety, pokud doručení trvale selže."

#: db/seeds/settings.rb:4428
msgid "Defines postmaster filter to identify sender user."
msgstr "Definuje filtr správce pošty pro identifikaci odesílajícího uživatele."

#: db/seeds/settings.rb:4419
msgid "Defines postmaster filter to identify session user."
msgstr "Definuje filtr správce pošty pro identifikaci uživatele relace."

#: db/seeds/settings.rb:4590
msgid "Defines postmaster filter to identify ticket group."
msgstr "Definuje filtr správce pošty pro identifikaci skupiny tiketu."

#: db/seeds/settings.rb:4527
msgid ""
"Defines postmaster filter to manage Checkmk (http://mathias-kettner.com/"
"check_mk.html) emails."
msgstr ""
"Definuje filtr správce pošty pro správu e-mailů z Checkmk (http://mathias-"
"kettner.com/check_mk.html)."

#: db/seeds/settings.rb:4509
msgid ""
"Defines postmaster filter to manage Icinga (http://www.icinga.org) emails."
msgstr ""
"Definuje filtr správce pošty pro správu e-mailů z Icingy (http://"
"www.icinga.org)."

#: db/seeds/settings.rb:4536
msgid ""
"Defines postmaster filter to manage Monit (https://mmonit.com/monit/) emails."
msgstr ""
"Definuje filtr správce pošty pro správu e-mailů z Monitu (https://mmonit.com/"
"monit/)."

#: db/seeds/settings.rb:4518
msgid ""
"Defines postmaster filter to manage Nagios (http://www.nagios.org) emails."
msgstr ""
"Definuje filtr správce pošty pro správu e-mailů z Nagiosu (http://"
"www.nagios.org)."

#: db/seeds/settings.rb:4338
msgid ""
"Defines postmaster filter to remove X-Zammad headers from untrustworthy "
"sources."
msgstr ""
"Definuje filtr správce pošty pro odstranění hlaviček X-Zammad z "
"nedůvěryhodných zdrojů."

#: db/seeds/settings.rb:4446
msgid ""
"Defines postmaster filter to remove references to local attachments from "
"incoming emails."
msgstr ""
"Definuje filtr správce pošty pro odstranění odkazů na lokální přílohy z "
"příchozích e-mailů."

#: db/seeds/settings.rb:4374
msgid ""
"Defines postmaster filter to set the owner (based on group follow up "
"assignment)."
msgstr ""
"Definuje filtr správce pošty pro nastavení vlastníka (podle přiřazování "
"navazujících zpráv ve skupině)."

#: db/seeds/settings.rb:4383
msgid ""
"Defines postmaster filter to set the sender/from of emails based on reply-to "
"header."
msgstr ""
"Definuje filtr správce pošty pro nastavení odesílatele (From) e-mailů na "
"základě hlavičky Reply-To."

#: db/seeds/settings.rb:4581
msgid ""
"Defines postmaster filter which sets the articles visibility to internal if "
"it is a rely to an internal article or the last outgoing email is internal."
msgstr ""
"Definuje filtr správce pošty, který nastaví viditelnost článku na interní, "
"pokud jde o odpověď na interní článek nebo pokud je poslední odchozí e-mail "
"interní."

#: db/seeds/settings.rb:4335
msgid "Defines postmaster filter."
msgstr "Definuje filtr správce pošty."

#: db/seeds/settings.rb:231
msgid "Defines pretty date format."
msgstr "Definuje formát relativního zobrazení data."

#: db/seeds/settings.rb:5571
msgid "Defines processing timeout for the html sanitizer."
msgstr "Definuje časový limit zpracování pro HTML sanitizer."

#: db/seeds/settings.rb:5230
msgid "Defines sync transaction backend."
msgstr "Definuje backend synchronních transakcí."

#: db/seeds/settings.rb:3247
msgid ""
"Defines the CAPTCHA provider used to protect the web form. Leave empty to "
"disable. The list of available providers is derived from the registered "
"FormSpamProtection::Captcha backends."
msgstr ""
"Určuje poskytovatele CAPTCHA, který chrání webový formulář. Pro vypnutí "
"ponechte prázdné. Seznam dostupných poskytovatelů vychází z registrovaných "
"backendů FormSpamProtection::Captcha."

#: db/seeds/settings.rb:5559
msgid "Defines the CSS font information for HTML emails."
msgstr "Definuje informace o CSS písmu pro HTML e-maily."

#: db/seeds/settings.rb:5371
msgid "Defines the CTI config."
msgstr "Definuje konfiguraci CTI."

#: db/seeds/settings.rb:4916
msgid "Defines the Checkmk token for allowing updates."
msgstr "Definuje token Checkmk pro umožnění aktualizací."

#: db/seeds/settings.rb:5507
msgid "Defines the Clearbit config."
msgstr "Definuje konfiguraci Clearbit."

#: db/seeds/settings.rb:5069
msgid "Defines the Exchange OAuth config."
msgstr "Definuje konfiguraci OAuth pro Exchange."

#: db/seeds/settings.rb:5056
msgid "Defines the Exchange config."
msgstr "Definuje konfiguraci Exchange."

#: db/seeds/settings.rb:381
msgid "Defines the HTTP protocol of your instance."
msgstr "Definuje HTTP protokol vaší instance."

#: db/seeds/settings.rb:5903
msgid "Defines the PGP config."
msgstr "Definuje konfiguraci PGP."

#: db/seeds/settings.rb:5446
msgid "Defines the Placetel config."
msgstr "Definuje konfiguraci Placetelu."

#: db/seeds/settings.rb:5833
msgid "Defines the S/MIME config."
msgstr "Definuje konfiguraci S/MIME."

#: db/seeds/settings.rb:5548
msgid "Defines the agent limit."
msgstr "Definuje limit počtu agentů."

#: db/seeds/settings.rb:467
msgid ""
"Defines the backend for geo IP lookups. Also shows location of an IP address "
"if it is traceable."
msgstr ""
"Definuje backend pro zjišťování polohy podle IP adresy. Zobrazuje také "
"polohu IP adresy, pokud ji lze dohledat."

#: db/seeds/settings.rb:521
msgid ""
"Defines the backend for geo calendar lookups. Used for initial calendar "
"succession."
msgstr ""
"Definuje backend pro vyhledávání kalendářů podle polohy. Používá se při "
"prvotním vytvoření kalendáře."

#: db/seeds/settings.rb:494
msgid ""
"Defines the backend for geo location lookups to store geo locations for "
"addresses."
msgstr "Definuje backend pro geolokaci, který ukládá zeměpisné polohy adres."

#: db/seeds/settings.rb:440
msgid "Defines the backend for user and organization image lookups."
msgstr "Definuje backend pro vyhledávání obrázků uživatelů a organizací."

#: db/seeds/settings.rb:187
msgid "Defines the backend service for ticket article language detection."
msgstr "Určuje backendovou službu pro detekci jazyka článku tiketu."

#: db/seeds/settings.rb:6657
msgid "Defines the chunking strategy for the knowledge base vector database."
msgstr ""
"Určuje strategii dělení textu (chunking) pro vektorovou databázi znalostní "
"báze."

#: db/seeds/settings.rb:2956
msgid ""
"Defines the configuration how many articles can be created in a minute range "
"globally."
msgstr ""
"Určuje, kolik článků lze celkově vytvořit v rámci minutového intervalu."

#: db/seeds/settings.rb:2937
msgid ""
"Defines the configuration how many articles can be created in a minute range "
"per ticket."
msgstr ""
"Určuje, kolik článků lze vytvořit v rámci minutového intervalu u jednoho "
"tiketu."

#: db/seeds/settings.rb:4231
msgid ""
"Defines the custom unit to be shown next to the time accounting input field."
msgstr ""
"Definuje vlastní jednotku, která se zobrazí vedle pole pro vykázání času."

#: db/seeds/settings.rb:4312
msgid "Defines the default calendar tickets subscription settings."
msgstr "Definuje výchozí nastavení odběru tiketů pro kalendář."

#: db/seeds/settings.rb:3733
msgid "Defines the default screen."
msgstr "Definuje výchozí obrazovku."

#: db/seeds/settings.rb:167
msgid "Defines the default system language."
msgstr "Definuje výchozí jazyk systému."

#: db/seeds/settings.rb:210
msgid "Defines the default system timezone."
msgstr "Definuje výchozí systémové časové pásmo."

#: db/seeds/settings.rb:4267
msgid "Defines the default time accounting type."
msgstr "Určuje výchozí typ počítání času."

#: db/seeds/settings.rb:699
msgid "Defines the default visibility for new notes."
msgstr "Definuje výchozí viditelnost pro nové poznámky."

#: db/seeds/settings.rb:5405
msgid ""
"Defines the duration of customer activity (in seconds) on a call until the "
"user profile dialog is shown."
msgstr ""
"Definuje dobu aktivity zákazníka (v sekundách) při hovoru, než se zobrazí "
"dialog uživatelského profilu."

#: db/seeds/settings.rb:6541
msgid ""
"Defines the fixed instructions that guide the AI Writing Assistant on e.g. "
"how to format its output."
msgstr ""
"Určuje pevné instrukce, kterými se AI asistent psaní řídí, např. jak "
"formátovat výstup."

#: db/seeds/settings.rb:319
msgid ""
"Defines the fully qualified domain name of the system. This setting is used "
"as a variable, #{setting.fqdn} which is found in all forms of messaging used "
"by the application, to build links to the tickets within your system."
msgstr ""
"Definuje plně kvalifikovaný doménový název (FQDN) systému. Toto nastavení se "
"používá jako proměnná #{setting.fqdn}, která se vyskytuje ve všech formách "
"zpráv odesílaných aplikací, k vytváření odkazů na tikety ve vašem systému."

#: db/seeds/settings.rb:4844
msgid "Defines the group of created tickets."
msgstr "Definuje skupinu vytvářených tiketů."

#: db/seeds/settings.rb:3135
msgid "Defines the group of tickets created via web form."
msgstr "Definuje skupinu tiketů vytvořených pomocí webového formuláře."

#: db/seeds/settings.rb:5136
msgid "Defines the i-doit config."
msgstr "Definuje konfiguraci i-doit."

#: db/seeds/settings.rb:4133
msgid "Defines the log levels for various logging actions of the Sequencer."
msgstr "Definuje úroveň logování pro různé logovací akce Sequenceru."

#: db/seeds/settings.rb:121
msgid "Defines the logo of the application, shown in the web interface."
msgstr "Definuje logo aplikace zobrazované ve webovém rozhraní."

#: db/seeds/settings.rb:3394
msgid "Defines the maximum accepted email size in MB."
msgstr "Definuje maximální přijatelnou velikost e-mailu v MB."

#: db/seeds/settings.rb:1057
msgid ""
"Defines the maximum number of allowed open tabs before auto cleanup removes "
"surplus tabs when creating new tabs."
msgstr ""
"Definuje maximální počet otevřených záložek, po jehož překročení automatické "
"čištění při otevírání nových záložek odebere ty nadbytečné."

#: db/seeds/settings.rb:6583
msgid ""
"Defines the minimum relevance score (in percent) a knowledge base answer "
"must reach to be suggested in the ticket sidebar."
msgstr ""
"Určuje minimální skóre relevance (v procentech), kterého musí odpověď "
"znalostní báze dosáhnout, aby byla navržena v postranním panelu tiketu."

#: db/seeds/settings.rb:97
msgid ""
"Defines the name of the application, shown in the web interface, tabs, and "
"title bar of the web browser."
msgstr ""
"Definuje název aplikace, zobrazený ve webovém rozhraní, záložkách a titulku "
"webového prohlížeče."

#: db/seeds/settings.rb:2850
msgid "Defines the permission level used for lookups."
msgstr "Definuje úroveň oprávnění používanou pro vyhledávání."

#: db/seeds/settings.rb:362
msgid "Defines the port of the WebSocket server."
msgstr "Určuje port WebSocket serveru."

#: db/seeds/settings.rb:6720
msgid "Defines the private key used to sign web push notifications."
msgstr "Určuje soukromý klíč, kterým se podepisují webová push oznámení."

#: db/seeds/settings.rb:6733
msgid ""
"Defines the public key browsers use to subscribe to web push notifications."
msgstr ""
"Určuje veřejný klíč, který prohlížeče používají k přihlášení k odběru "
"webových push oznámení."

#: db/seeds/settings.rb:7
msgid "Defines the random application secret."
msgstr "Definuje náhodný tajný klíč aplikace."

#: db/seeds/settings.rb:4625
msgid "Defines the sender email address of Icinga emails."
msgstr "Definuje e-mailovou adresu odesílatele e-mailů z Icingy."

#: db/seeds/settings.rb:4723
msgid "Defines the sender email address of Nagios emails."
msgstr "Definuje e-mailovou adresu odesílatele e-mailů z Nagiosu."

#: db/seeds/settings.rb:4821
msgid "Defines the sender email address of the service emails."
msgstr "Definuje e-mailovou adresu odesílatele servisních e-mailů."

#: db/seeds/settings.rb:3554
msgid "Defines the sender of email notifications."
msgstr "Definuje odesílatele e-mailových oznámení."

#: db/seeds/settings.rb:3372
msgid ""
"Defines the separator between the agent's real name and the given group "
"email address."
msgstr ""
"Definuje oddělovač mezi skutečným jménem agenta a zadanou e-mailovou adresou "
"skupiny."

#: db/seeds/settings.rb:1151
msgid ""
"Defines the session timeout for inactivity of users. Based on the assigned "
"permissions the highest timeout value will be used, otherwise the default."
msgstr ""
"Definuje časový limit relace při nečinnosti uživatelů. Podle přiřazených "
"oprávnění se použije nejvyšší hodnota, jinak výchozí."

#: db/seeds/settings.rb:5309
msgid "Defines the sipgate.io config."
msgstr "Definuje konfiguraci sipgate.io."

#: db/seeds/settings.rb:4674
msgid "Defines the state of auto-closed tickets."
msgstr "Definuje stav automaticky uzavřených tiketů."

#: db/seeds/settings.rb:294
msgid ""
"Defines the system identifier. Every ticket number contains this ID. This "
"ensures that only tickets which belong to your system will be processed as "
"follow-ups (useful when communicating between two instances of Zammad)."
msgstr ""
"Definuje identifikátor systému. Toto ID obsahuje každé číslo tiketu. Tím je "
"zajištěno, že jako navazující zprávy budou zpracovány jen tikety, které "
"patří do vašeho systému (užitečné při komunikaci mezi dvěma instancemi "
"Zammadu)."

#: db/seeds/settings.rb:3072
msgid "Defines the tab behaviour after a ticket action."
msgstr "Definuje chování záložky po akci s tiketem."

#: db/seeds/settings.rb:2867
msgid "Defines the ticket states used for lookups."
msgstr "Definuje stavy tiketů používané pro vyhledávání."

#: db/seeds/settings.rb:5704
msgid "Defines the timeframe during which a self-created note can be deleted."
msgstr "Definuje časové období, během kterého lze smazat vlastní poznámku."

#: db/seeds/settings.rb:5460
msgid "Defines the token for Placetel."
msgstr "Definuje token pro Placetel."

#: db/seeds/settings.rb:5251
msgid ""
"Defines the transaction backend to detect customer signatures in emails."
msgstr ""
"Definuje transakční backend pro rozpoznávání podpisů zákazníků v e-mailech."

#: db/seeds/settings.rb:5233
msgid "Defines the transaction backend to execute triggers."
msgstr "Definuje transakční backend pro provádění spouštěčů."

#: db/seeds/settings.rb:5242
msgid "Defines the transaction backend to send agent notifications."
msgstr "Definuje transakční backend pro zasílání oznámení agentům."

#: db/seeds/settings.rb:5529
msgid ""
"Defines the transaction backend which detects caller IDs in objects and "
"stores them for CTI lookups."
msgstr ""
"Definuje transakční backend, který rozpoznává čísla volajících v objektech a "
"ukládá je pro vyhledávání v CTI."

#: db/seeds/settings.rb:5538
msgid "Defines the transaction backend which executes time based triggers."
msgstr "Definuje transakční backend, který provádí časové spouštěče."

#: db/seeds/settings.rb:5520
msgid ""
"Defines the transaction backend which will enrich customer and organization "
"information from Clearbit (http://www.clearbit.com)."
msgstr ""
"Definuje transakční backend, který obohacuje informace o zákaznících a "
"organizacích z Clearbitu (http://www.clearbit.com)."

#: app/assets/javascripts/app/views/time_accounting/settings.jst.eco:14
#: db/seeds/settings.rb:4213
msgid "Defines the unit to be shown next to the time accounting input field."
msgstr "Definuje jednotku, která se zobrazí vedle pole pro vykázání času."

#: db/seeds/settings.rb:2799
msgid ""
"Defines the warning message that is shown when a matching ticket is present."
msgstr ""
"Definuje varovnou zprávu, která se zobrazí, když existuje odpovídající tiket."

#: db/seeds/settings.rb:2782
msgid ""
"Defines the warning title that is shown when a matching ticket is present."
msgstr ""
"Definuje varovný nadpis, který se zobrazí, když existuje odpovídající tiket."

#: db/seeds/settings.rb:5239
msgid "Defines transaction backend."
msgstr "Definuje transakční backend."

#: db/seeds/settings.rb:2833
msgid ""
"Defines whether the matching tickets are shown in case of already existing "
"tickets."
msgstr "Definuje, zda se mají zobrazit odpovídající tikety, pokud už existují."

#: db/seeds/settings.rb:6648
msgid ""
"Defines which knowledge base categories are excluded from the vector "
"database. Sub-categories of an excluded category are excluded as well. Note "
"that the vector database has to be rebuilt after removing a category from "
"this list, so that its answers get indexed."
msgstr ""
"Určuje, které kategorie znalostní báze jsou vyloučeny z vektorové databáze. "
"Vyloučeny jsou i podkategorie vyloučené kategorie. Po odebrání kategorie z "
"tohoto seznamu je nutné vektorovou databázi znovu sestavit, aby se odpovědi "
"z ní zaindexovaly."

#: db/seeds/settings.rb:3270
msgid "Defines which parameters are allowed to be submitted via the form API."
msgstr "Určuje, které parametry je povoleno odesílat přes API formuláře."

#: db/seeds/settings.rb:6450
msgid "Defines which roles are allowed to access the desktop BETA UI switch."
msgstr ""
"Určuje, které role mají přístup k přepínači desktopového BETA rozhraní."

#: db/seeds/settings.rb:2765
msgid "Defines which ticket attributes are checked before creating a ticket."
msgstr "Definuje, které atributy tiketu se kontrolují před vytvořením tiketu."

#: app/assets/javascripts/app/views/ai/ticket_summary.jst.eco:43
msgid "Defines which tickets can use the ticket summary sidebar."
msgstr ""
"Určuje, které tikety mohou používat postranní panel se shrnutím tiketu."

#: db/seeds/settings.rb:6014
msgid "Defines which user roles automatic article translation applies to."
msgstr ""
"Určuje, na které role uživatelů se automatický překlad článků vztahuje."

#: db/seeds/settings.rb:2816
msgid ""
"Defines which user roles will receive a warning in case of matching tickets."
msgstr ""
"Definuje, které role uživatelů obdrží varování, pokud existují odpovídající "
"tikety."

