#: db/seeds/settings.rb:6357
msgid "Enable ticket summary for following matching tickets."
msgstr "নিম্নলিখিত মিলে যাওয়া টিকিটের জন্য টিকিট সারাংশ সক্রিয় করুন।"

#: db/seeds/settings.rb:4156
