#: db/seeds/settings.rb:3672
msgid "Enable/disable online chat."
msgstr "অনলাইন চ্যাট সক্রিয়/নিষ্ক্রিয় করুন।"

#: app/assets/javascripts/app/views/customer_chat/setting.jst.eco:37
