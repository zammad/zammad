<% 
  # Determine subject based on action
  case action.to_s
  when 'create'
    subject = "Ticket ##{ticket.number} shared with your group"
  when 'update'
    subject = "Ticket ##{ticket.number} share updated"
  when 'revoke'
    subject = "Ticket ##{ticket.number} share revoked"
  when 'delete'
    subject = "Ticket ##{ticket.number} share deleted"
  else
    subject = "Ticket ##{ticket.number} share notification"
  end
%><%= subject %>

<div>Hi #{recipient.firstname},</div>
<br>
<div>
<% 
  case action.to_s
  when 'create'
    message = "Ticket ##{ticket.number} has been shared with your group."
  when 'update'
    message = "The share for ticket ##{ticket.number} has been updated."
  when 'revoke'
    message = "The share for ticket ##{ticket.number} has been revoked."
  when 'delete'
    message = "The share for ticket ##{ticket.number} has been deleted."
  else
    message = "This notification was sent regarding a ticket share for ##{ticket.number}."
  end
%><%= message %>
</div>
<br>
<div>
Ticket: ##{ticket.number}<br>
Title: #{ticket.title}<br>
Group: <%= share.group_name %><br>
Shared By: <%= share.shared_by_name %><br>
<% if share.message.present? %>
Message: #{share.message}<br>
<% end %>
<% if share.expires_at.present? %>
Expires: <%= share.expires_at %><br>
<% end %>
</div>
<br>
<div>
  <a href="#{url}" target="zammad_app">View this in Zammad</a>
</div>