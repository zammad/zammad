টিকিট আপডেট হয়েছে (#{ticket.title})

<div>প্রিয় #{recipient.firstname},</div>
<br>
<div>
"<b>#{current_user.longname}</b>" টিকিট (#{ticket.title}) আপডেট করেছেন।
</div>
<br>
<% if @objects[:changes].present? %>
  <div>
  পরিবর্তনসমূহ:<br>
  <% @objects[:changes].each do |key, value| %>
    <%= t key %>: <%= h value[0] %> -&gt; <%= h value[1] %><br>
  <% end %>
  </div>
<% end %>
<br>
<% if @objects[:article] %>
  <div>
  তথ্য:
  <blockquote type="cite">
  #{article.body_as_html}
  </blockquote>
  </div>
<% end %>
<br>
<div>
  <a href="#{config.http_type}://#{config.fqdn}/#ticket/zoom/#{ticket.id}<% if @objects[:article] %>/#{article.id}<% end %>" target="zammad_app">#{config.product_name}-এ এটি দেখুন</a>
</div>
