<style type="text/css">
  blockquote {
    border-left: 2px solid blue;
    padding-left: 1em;
  }
  .email-header {
    width: 100%;
    max-width: 600px;
    border-collapse: collapse;
  }
  .email-header .logo img {
    display: block;
    max-width: 145px;
    height: auto;
  }
  .email-header .help-link {
    text-align: right;
    vertical-align: middle;
  }
  .email-header .help-link a {
    color: #009bd7;
    font-size: 16px;
    text-decoration: none;
  }
  .email-divider {
    border: none;
    border-top: 1px solid #e2e2e2;
    width: 100%;
    max-width: 600px;
    margin: 16px 0;
  }
  .btn {
    display: inline-block;
    background-color: #009bd7;
    color: #ffffff !important;
    font-size: 14px;
    text-decoration: none;
    padding: 10px 16px;
    border-radius: 5px;
  }
  .email-footer {
    font-size: 14px;
    color: #7d7d7d;
    width: 100%;
    max-width: 600px;
    text-align: center;
  }
  .email-footer .reason {
    font-size: 10px;
    display: block;
    margin-bottom: 8px;
  }
  .email-footer strong {
    display: block;
    margin-bottom: 4px;
  }
  .email-footer a {
    color: #7d7d7d;
    text-decoration: underline;
  }
</style>
<% if @objects[:standalone] != true %>
<table class="email-header" role="presentation" border="0" cellpadding="0" cellspacing="0">
  <tr>
    <td class="logo">
      <img src="<%= c 'http_type' %>://<%= c 'fqdn' %>/api/v1/system_assets/product_logo/<%= c 'product_logo' %>" alt="<%= c 'product_name' %>">
    </td>
    <!-- No dedicated help-center page/URL exists yet, so this points at the
         instance root - update once a real Central de Ajuda destination exists. -->
    <td class="help-link">
      <a href="<%= c 'http_type' %>://<%= c 'fqdn' %>">Central de Ajuda</a>
    </td>
  </tr>
</table>
<hr class="email-divider">
<% end %>

<%= d 'message', false %>

<% if @objects[:standalone] != true %>
<hr class="email-divider">
<div class="email-footer">
  <% if @objects[:reason] %>
    <span class="reason"><%= t @objects[:reason] %></span>
  <% end %>
  <strong>Enviado por <%= c 'product_name' %></strong>
  <div>
    Caso não queira mais receber estes e-mails, <a href="<%= c 'http_type' %>://<%= c 'fqdn' %>/#profile/notifications"><%= t 'clique aqui' %></a>.
  </div>
  <% if c('organization').present? %><div><%= c 'organization' %></div><% end %>
</div>
<% end %>
