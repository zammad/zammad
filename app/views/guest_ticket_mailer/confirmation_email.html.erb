<div style="font-family: Inter, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto;">
  <div style="background: linear-gradient(135deg, #1e88e5 0%, #1565c0 100%); padding: 40px; text-align: center; border-radius: 8px 8px 0 0;">
    <h1 style="color: white; margin: 0; font-size: 28px;">Ticket Submitted Successfully</h1>
  </div>

  <div style="background: #f5f5f5; padding: 40px;">
    <p style="font-size: 16px; margin-bottom: 20px;">Thank you for submitting your request to Leasys Support.</p>

    <div style="background: white; padding: 20px; border-radius: 4px; margin: 20px 0;">
      <p style="margin: 0 0 10px 0; color: #999; font-size: 12px; text-transform: uppercase;">Ticket Reference</p>
      <p style="margin: 0 0 20px 0; font-size: 24px; font-weight: bold; color: #1e88e5;"><%= @reference_number %></p>
      <p style="margin: 0; color: #666; font-size: 14px;">Please save this reference number for your records. You'll need it to track your ticket.</p>
    </div>

    <h2 style="font-size: 16px; margin-top: 30px; margin-bottom: 10px;">What Happens Next</h2>
    <ol style="color: #666; font-size: 14px;">
      <li>We've received your submission</li>
      <li>Our support team will review it shortly</li>
      <li>You'll receive updates via email</li>
      <li>We aim to respond within 24 hours</li>
    </ol>

    <div style="background: #e3f2fd; padding: 15px; border-radius: 4px; margin-top: 20px;">
      <p style="margin: 0; font-size: 14px; color: #1565c0;">
        <strong>Need immediate help?</strong> Contact us at
        <a href="mailto:support@leasys.com" style="color: #1e88e5; text-decoration: none;">support@leasys.com</a>
        or call
        <a href="tel:+18005329780" style="color: #1e88e5; text-decoration: none;">+1-800-LEASYS</a>
      </p>
    </div>
  </div>

  <div style="background: #fafafa; padding: 20px; text-align: center; border-radius: 0 0 8px 8px; border-top: 1px solid #eee;">
    <p style="margin: 0; font-size: 12px; color: #999;">
      © 2024 Leasys. All rights reserved.<br/>
      <a href="https://leasys.com" style="color: #1e88e5; text-decoration: none;">Visit our website</a>
    </p>
  </div>
</div>
