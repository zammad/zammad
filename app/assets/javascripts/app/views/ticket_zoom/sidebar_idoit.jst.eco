<% for object in @objects: %>
  <div class="sidebar-block">
    <label class="horizontal">
      <% if @searchable: %>
        <a href="#" class="js-idoitObjectId u-clickable" data-object-id="<%= object.id %>" title="<%- @T('Search tickets linked to this i-doit object') %>">
          <%- @T('ID:') %> <%- @T(object.id) %>
        </a>
      <% else: %>
        <%- @T('ID:') %> <%- @T(object.id) %>
      <% end %>
      <div class="list-item-delete js-delete" data-object-id="<%= object.id %>" data-type="remove">
        <%- @Icon('diagonal-cross') %>
      </div>
    </label>
    <a href="<%- object.link %>" target="_blank"><%= object.title %><br></a>
    <%- @T('Status:') %> <%= object.cmdb_status_title %><br>
    <%- @T('Type:') %> <%= object.type_title %><br>
  </div>
<% end %>
