<label><%- @T('Tags') %></label>
<ul class="list list--sidebar">
  <% for tag in @tags: %>
  <li class="list-item">
    <a href="#" class="list-item-name list-item-name-shrinkable js-tag" title="<%= tag %>"><%= tag %></a>
    <% if @editable: %>
      <div class="list-item-delete js-delete">
        <%- @Icon('diagonal-cross') %>
      </div>
    <% end %>
  <% end %>
</ul>
<% if @editable: %>
 <div class="text-muted horizontal center justify-end gap-16">
   <span class="js-newTagLabel u-clickable" href="#">
     + <%- @T('Tag') %>
   </span>
 </div>
 <form class="ui-front">
   <input type="text" name="new_tag" class="hide js-newTagInput" autocomplete="off">
 </form>
<% end %>
