<div class="js-aiUnsupportedEmbeddingWarning">
  <% if @hasUnsupportedEmbeddingWarning: %>
    <div class="help-inline help-inline--warning"><%- @T('does not support vector embedding for semantic search') %></div>
    <% if @defaultProviderName: %>
      <div>
        <%- @T('Instead, the default provider will be used for this purpose: %s', @defaultProviderName) %>
        <span class="badge badge--primary"><%- @Tp('Semantic search') %></span>
      </div>
    <% end %>
  <% end %>
  <% if @hasMissingDefaultWarning: %>
    <div class="help-inline help-inline--warning"><%- @T('The system currently has no default provider for semantic search. Please define a suitable provider before using this feature.') %></div>
  <% end %>
</div>
