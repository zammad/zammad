<div class="js-aiDefaultProviders">
  <p><%- @T('The configured AI provider(s) will be used based on their assigned default purposes:') %></p>
  <ul>
  <% for provider in @providers: %>
    <% if not provider.default_chat and not provider.default_embedding and not provider.default_ocr then continue %>
    <li>
      <%= provider.name %>
      <% if provider.default_chat: %><span class="badge badge--ai"><%- @Tp('Chat completions') %></span><% end %>
      <% if provider.default_embedding: %><span class="badge badge--primary"><%- @Tp('Semantic search') %></span><% end %>
      <% if provider.default_ocr: %><span class="badge badge--ghost"><%- @Tp('Image text recognition') %></span><% end %>
    </li>
  <% end %>
  </ul>
</div>
