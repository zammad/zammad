<%- @V('popover/single_object_generic', object: @object, attributes: @attributes) %>
<% if @object.parent?().canBePublished?(): %>
  <div class="state-badge">
    <%- @Icon('task-state', @object.parent().can_be_published_state()) %>
    <span class="<%= @object.parent().can_be_published_state_css() %>">
      <%- @T(@object.parent().can_be_published_state()) %>
    </span>
  </div>

  <hr>

  <% answer = @object.parent() %>

  <div class="popover-block">
    <div class="horizontal one-column">
      <% if time = answer.internal_at: %>
        <div class="column">
          <label><%- @T('Internally published at') %></label>
          <%- @humanTime(time, false, 'time', 'absolute') %>
        </div>
      <% end %>
      <% if time = answer.published_at: %>
        <div class="column">
          <label><%- @T('Published at') %></label>
          <%- @humanTime(time, false, 'time', 'absolute') %>
        </div>
      <% end %>
      <% if time = answer.archived_at: %>
        <div class="column">
          <label><%- @T('Archived at') %></label>
          <%- @humanTime(time, false, 'time', 'absolute') %>
        </div>
      <% end %>

      <div class="column">
        <label><%- @T('Category') %></label>
        <a href="<%= answer.category().uiUrl(App.KnowledgeBaseLocale.find(@object.kb_locale_id)) %>" title="<%= answer.category().categoriesForSearch({ full: true, kb_locale: App.KnowledgeBaseLocale.find(@object.kb_locale_id) }) %>"><%= answer.category().guaranteedTitle(@object.kb_locale_id) %></a>
      </div>
      <div class="column">
        <label><%- @T('Language') %></label>
        <%= App.KnowledgeBaseLocale.localeFor(@object).systemLocale().name %>
      </div>

      <% if !_.isEmpty(answer.tags): %>
        <div class="column">
          <label><%- @T('Tags') %></label>
          <div class="kb-answer-tags">
            <% for tag in answer.tags: %>
              <a href="#" class="js-tag" title="<%= tag %>"><%= tag %></a>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
