<label><%- @T('Related knowledge') %></label>
<ol class="tasks tasks--standalone">
  <% for item in @list: %>
    <li class="task">
      <div class="icon-holder">
      	<%- @Icon('knowledge-base') %>
      </div>
      <div class="task-text">
        <a class="name kb-answer-popover" data-id="<%- item.id %>" href="<%- item.url %>"><%= item.title %></a>
      </div>
      <% if @editable: %>
        <a class="list-item-delete js-delete" data-object="KnowledgeBase::Answer::Translation" data-object-id="<%= item.id %>" data-link-type="normal">
          <%- @Icon('diagonal-cross') %>
        </a>
      <% end %>
    </li>
  <% end %>
</ol>
<% if @editable: %>
  <div class="text-muted horizontal <%= if @aiEnabled then 'justify-between' else 'justify-end' %> center gap-16">
    <% if @aiEnabled: %>
      <span class="js-kb-ai-generate kb-ai-generate-wrapper u-clickable">+ <%- @T('AI draft') %></span>
    <% end %>
    <span class="js-add u-clickable">+ <%- @T('Link') %></span>
  </div>
<% end %>
