<div class="page-header">
  <div class="page-header-title">
    <h1><%- @T( 'Package' ) %> <small><%- @T('Management') %></small></h1>
  </div>
  <div class="page-header-meta">
    <a data-type="settings" class="btn js-packageSettings" href="#"><%- @T('Configure') %></a>
  </div>
</div>

<div class="page-content">
  <p>
    <%- @T('The installation of packages comes with security implications, because arbitrary code will be executed in the context of the Zammad application.') %>
    <br>
    <%- @T('Only packages from known, trusted, and verified sources should be installed.') %>
  </p>
  <p>
    <%- @T('After installing, updating, or uninstalling packages the following commands need to be executed on the server:') %>
    <ul>
    <% if @package_installation: %>
    <% if @local_gemfiles: %>
      <li><code>root> zammad config:set BUNDLE_DEPLOYMENT=0</code></li>
      <li><code>root> zammad run bundle config set --local deployment 'false'</code></li>
      <li><code>root> zammad run bundle install</code></li>
    <% end %>
      <li><code>root> zammad run rake zammad:package:post_install</code></li>
    <% else: %>
      <% if @local_gemfiles: %>
      <li><code>zammad> bundle install</code></li>
      <% end %>
      <li><code>zammad> rake zammad:package:post_install</code></li>
    <% end %>
      <li><code>root> systemctl restart zammad</code></li>
    </ul>
  </p>
  <!--
  <ul class="nav nav-tabs nav-stacked">
    <li class=""><a data-type="" ><%- @T('Installed') %></a></li>
    <li class=""><a data-type="" ><%- @T('Store') %></a></li>
  </ul>
  -->
  <p>
    <form action="<%= App.Config.get('api_path') %>/packages" method="post" enctype="multipart/form-data" class="horizontal center">
      <input type="hidden" name="authenticity_token" value="<%= App.Ajax.token() %>"/>
      <input type="file" name="file_upload" class="js-fileUpload" />
      <button class="align-right btn btn--primary js-submit" type="submit" disabled="disabled"><%- @T('Install Package') %></button>
    </form>
  </p>

  <h2 class="package-table-heading"><%- @T('Installed packages') %></h2>

<% if _.isEmpty(@packages): %>
  <table class="table table--placeholder">
    <thead><tr><th><%- @T('No Entries') %>
  </table>
<% else: %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th><%- @T('Name') %></th>
        <th><%- @T('Version') %></th>
        <th><%- @T('Vendor') %></th>
        <th><%- @T('State') %></th>
        <th class="package-action-header"><%- @T('Action') %></th>
      </tr>
    </thead>
    <tbody>
    <% for item in @packages: %>
      <tr data-id="<%= item.id %>">
        <td><%= item.name %></td>
        <% meta = @api_package_metas[item.name]; lastLog = meta && meta.change_log && meta.change_log.length && meta.change_log[meta.change_log.length - 1] %>
        <td><%= item.version %><% if _.contains(item.action, 'update_api'): %> <span class="badge badge--closed"<% if lastLog: %> title="<%= lastLog.content %> (<%- @Ttimestamp(lastLog.date) %>)"<% end %>><%- @T('Update to %s', meta.version) %></span><% end %></td>
        <td><% if item.url: %><a href="<%= item.url %>" target="_blank"><% end %><%= item.vendor %><% if item.url: %></a><% end %></td>
        <td><%- @T(item.state) %></td>
        <td class="package-action-cell no-padding">
          <div class="dropdown dropdown--actions">
            <div class="btn btn--table btn--text btn--secondary js-action package-action-toggle" data-toggle="dropdown">
              <%- @Icon('overflow-button') %>
            </div>
            <ul class="dropdown-menu dropdown-menu-right" role="menu">
            <% for action in item.action: %>
              <li role="presentation" class="js-packageAction" data-table-action="<%= action %>">
                <a role="menuitem" tabindex="-1">
                  <% if action is 'update_api': %>
                    <span class="dropdown-iconSpacer">
                      <%- @Icon('reload') %>
                    </span>
                    <%- @T('Update package') %>
                  <% else if action is 'uninstall': %>
                    <span class="dropdown-iconSpacer">
                      <%- @Icon('trash') %>
                    </span>
                    <%- @T('Uninstall package') %>
                    <% else: %>
                      <%- @T(action) %>
                    <% end %>
                  </a>
                </li>
              <% end %>
              </ul>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @token_present: %>
  <h2 class="package-table-heading"><%- @T('Available packages') %></h2>
  <% if _.isEmpty(@api_packages_installable): %>
  <table class="table table--placeholder">
    <thead><tr><th><%- @T('No Entries') %>
  </table>
  <% else: %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th><%- @T('Name') %></th>
        <th><%- @T('Version') %></th>
        <th><%- @T('Vendor') %></th>
        <th><%- @T('State') %></th>
        <th class="package-action-header"><%- @T('Action') %></th>
      </tr>
    </thead>
    <tbody>
    <% for name in @api_packages_installable: %>
      <% item = @api_package_metas[name] %>
      <tr data-id="<%= item.name %>">
        <td><%= item.name %></td>
        <td><%= item.version %></td>
        <td><% if item.url: %><a href="<%= item.url %>" target="_blank"><% end %><%= item.vendor %><% if item.url: %></a><% end %></td>
        <td><%- @T('not installed') %></td>
        <td class="package-action-cell no-padding">
          <div class="dropdown dropdown--actions">
            <div class="btn btn--table btn--text btn--secondary js-action package-action-toggle" data-toggle="dropdown">
              <%- @Icon('overflow-button') %>
            </div>
            <ul class="dropdown-menu dropdown-menu-right" role="menu">
              <li role="presentation" class="js-packageAction" data-table-action="install_api">
                <a role="menuitem" tabindex="-1">
                  <span class="dropdown-iconSpacer">
                    <%- @Icon('package') %>
                  </span>
                  <%- @T('Install package') %>
                </a>
              </li>
            </ul>
          </div>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <% end %>
<% end %>
</div>
