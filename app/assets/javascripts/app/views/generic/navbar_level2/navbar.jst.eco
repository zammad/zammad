<% if @groups: %>
  <% for group in @groups: %>
    <% if !_.isEmpty(group.items): %>
      <% for item in group.items: %>
        <a class="navlevel2-tab <% if item.active: %>navlevel2-tab--on<% end %> <% if item.hidden: %>hidden<% end %>" href="<%= item.target %>"><%- @T(item.name) %></a>
      <% end %>
    <% end %>
  <% end %>
<% end %>
