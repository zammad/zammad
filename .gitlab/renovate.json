{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ignorePaths": ["**/node_modules/**"],
  "enabledManagers": [
    "bundler",
    "npm",
    "github-actions",
    "devcontainer",
    "dockerfile",
    "docker-compose",
    "gitlabci",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.gitlab/ci/.*\\.yml$/"
      ],
      "matchStrings": ["DEVCONTAINERS_CLI_VERSION: '(?<currentValue>[^']+)'"],
      "depNameTemplate": "@devcontainers/cli",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.gitlab/ci/.*\\.yml$/"
      ],
      "matchStrings": ["PLAYWRIGHT_VERSION: '(?<currentValue>[^']+)'"],
      "depNameTemplate": "playwright",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^lib/form_spam_protection/captcha/.*\\.rb$/"
      ],
      "matchStrings": ["cdn\\.jsdelivr\\.net/npm/(?<depName>[^@]+)@(?<currentValue>[^/]+)/"],
      "datasourceTemplate": "npm"
    }
  ],
  "bundler": {
    "lockFileMaintenance": {
      "enabled": true,
      "extends": ["schedule:weekly"],
      "branchTopic": "lock-file-maintenance-ruby",
      "commitMessageExtra": "(Ruby)"
    }
  },
  "gitlabci": {
    "managerFilePatterns": [
      "/^\\.gitlab/ci/.*\\.yml$/"
    ]
  },
  "devcontainer": {
    "managerFilePatterns": [
      "/^\\.devcontainer/[^/]+/devcontainer\\.json$/"
    ]
  },
  "npm": {
    "lockFileMaintenance": {
      "enabled": true,
      "extends": ["schedule:weekly"],
      "branchTopic": "lock-file-maintenance-js",
      "commitMessageExtra": "(JS)"
    }
  },
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "addLabels": ["security"]
  },
  "assignees": ["fl"],
  "packageRules": [
    {
      "matchCategories": ["ruby"],
      "addLabels": ["ruby"],
      "rangeStrategy": "in-range-only"
    },
    {
      "matchCategories": ["js"],
      "addLabels": ["javascript"],
      "rangeStrategy": "bump"
    },
    {
      "matchCategories": ["js"],
      "matchFileNames": ["public/**"],
      "enabled": false
    },
    {
      "matchCategories": ["js"],
      "matchDepTypes": ["engines", "peerDependencies"],
      "enabled": false
    },
    {
      "matchCategories": ["js"],
      "matchFileNames": [".dev/cypress/package.json"],
      "addLabels": ["cypress"]
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchFileNames": [
        ".dev/**",
        ".gitlab/packager.io/**"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "playwright",
        "playwright-ruby-client",
        "capybara-playwright-driver"
      ],
      "groupName": "Playwright packages",
      "groupSlug": "playwright"
    },
    {
      "matchDepNames": ["ruby", "docker.io/library/ruby"],
      "groupName": "Ruby version",
      "groupSlug": "ruby-version"
    },
    {
      "matchDepNames": ["node", "docker.io/library/node"],
      "groupName": "Node version",
      "groupSlug": "node-version"
    },
    {
      "matchCategories": ["js"],
      "groupName": "Eslint packages",
      "groupSlug": "eslint",
      "matchPackageNames": ["/eslint/"]
    },
    {
      "matchCategories": ["js"],
      "groupName": "Oxc packages",
      "groupSlug": "oxc",
      "matchPackageNames": ["oxlint", "oxfmt", "eslint-plugin-oxlint"]
    },
    {
      "matchCategories": ["js"],
      "groupName": "Stylelint packages",
      "groupSlug": "stylelint",
      "matchPackageNames": ["/stylelint/"]
    },
    {
      "matchCategories": ["js"],
      "matchPackageNames": ["typescript", "type-fest", "/^@types/"],
      "groupName": "Typescript/Types packages",
      "groupSlug": "typescript"
    },
    {
      "matchCategories": ["js"],
      "matchPackageNames": [
        "vitest",
        "jsdom",
        "@vue/test-utils",
        "@pinia/testing",
        "/^@testing-library/",
        "/mock/"
      ],
      "groupName": "Test related packages",
      "groupSlug": "test-related"
    },
    {
      "matchCategories": ["js"],
      "groupName": "Vite packages",
      "groupSlug": "vite-related",
      "matchPackageNames": ["/^vite/", "/^@vitejs/", "!vitest"]
    },
    {
      "matchCategories": ["js"],
      "groupName": "Formkit packages",
      "groupSlug": "formkit-related",
      "matchPackageNames": ["/^@formkit/", "!@formkit/drag-and-drop"]
    },
    {
      "matchCategories": ["js"],
      "matchPackageNames": [
        "pinia",
        "/^@vue/",
        "/^vue/",
        "!@vue/eslint-config-typescript",
        "!@vuepic/vue-datepicker",
        "!/^@vueuse/"
      ],
      "groupName": "Vue packages",
      "groupSlug": "vue"
    },
    {
      "matchPackageNames": ["@vue/eslint-config-typescript"],
      "groupName": "Vue ESLint Configs",
      "groupSlug": "vue-eslint-configs"
    },
    {
      "matchCategories": ["js"],
      "matchPackageNames": [
        "prosemirror-model",
        "prosemirror-state",
        "/^@tiptap/",
        "/^prosemirror/"
      ],
      "groupName": "Tiptap packages",
      "groupSlug": "tiptap-related"
    },
    {
      "matchCategories": ["js"],
      "matchPackageNames": [
        "postcss",
        "postcss-html",
        "sass",
        "autoprefixer",
        "/tailwind/",
        "!@formkit/tailwindcss"
      ],
      "groupName": "Tailwind/Styling packages",
      "groupSlug": "tailwind-styling-related"
    }
  ]
}
