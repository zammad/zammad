{
  "permissions": {
    "allow": [
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git blame *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git status *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git cherry-pick *)",
      "Bash(glab *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(bundle exec rubocop *)",
      "Bash(RAILS_ENV=test VITE_TEST_MODE=1 bundle exec rspec *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm generate-graphql-api)",
      "Bash(pnpm generate-setting-types)",
      "Bash(pnpm analyse:fallow*)",
      "Bash(pnpm exec fallow dead-code *)",
      "Bash(pnpm exec fallow dupes *)",
      "Bash(pnpm exec fallow trace *)",
      "Bash(pnpm exec fallow explain *)",
      "Bash(pnpm exec fallow fix --dry-run *)",
      "mcp__github__issue_read",
      "mcp__github__list_issue_comments",
      "mcp__codegraph__*"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.dev/hooks/after-edit.sh",
            "timeout": 240
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec codegraph prompt-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.dev/hooks/fallow-gate.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
