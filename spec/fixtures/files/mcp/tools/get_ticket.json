{
  "name": "get_ticket",
  "title": "Get ticket",
  "description": "Read one ticket of Zammad: its attributes, its customer, organization and owner, what it is linked to, the first message and the latest messages, cleaned and shortened. With response_format \"concise\" only the attributes, the counts and the start of the first message. get_ticket_articles reads the other messages and cut ones with their text, get_user and get_organization the customer, owner and organization in detail, such as their phone, get_ticket_history who changed what and when. Name it by its ticket_number, ticket_id or ticket_url. In the detailed response, a message's files are listed with their IDs, by which read_attachment reads them; both responses name the messages that have files, and both the ticket's shared draft, which get_shared_draft reads.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ticket_number": {
        "type": "string",
        "description": "The ticket number as shown in Zammad, e.g. \"31042\" or \"Ticket#31042\"."
      },
      "ticket_id": {
        "type": "integer",
        "description": "The internal ID of the ticket, e.g. 8812."
      },
      "ticket_url": {
        "type": "string",
        "description": "A link to the ticket in Zammad."
      },
      "response_format": {
        "type": "string",
        "description": "detailed: attributes with all custom fields, links, the first and the latest messages. concise: attributes, counts and the start of the first message.",
        "enum": [
          "detailed",
          "concise"
        ],
        "default": "detailed"
      },
      "latest": {
        "type": "integer",
        "description": "How many of the latest messages to include besides the first one (detailed only).",
        "default": 3,
        "minimum": 0,
        "maximum": 20
      }
    },
    "required": [],
    "additionalProperties": false
  },
